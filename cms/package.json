{
  "name": "mmfauf-cms",
  "private": true,
  "version": "1.0.0",
  "description": "Keystatic admin UI for editing src/data/*.json via GitHub storage mode (commits go straight to the repo over the GitHub API). Deployed separately from the portfolio site itself, as a Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.4",
    "@keystatic/next": "^5.0.4",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  }
}
