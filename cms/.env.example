# Copy to .env for local dev. In production these are set as Cloudflare
# Worker secrets instead (`wrangler secret put NAME`) — never commit real
# values here.
#
# KEYSTATIC_GITHUB_CLIENT_ID / KEYSTATIC_GITHUB_CLIENT_SECRET / NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG
# are generated for you by Keystatic's "Create GitHub App" flow — visit
# /keystatic locally once the other vars below are set and follow the prompts.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Session signing key. Generate with: openssl rand -base64 32
KEYSTATIC_SECRET=
